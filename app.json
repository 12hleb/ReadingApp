{
  "expo": {
    "name": "Reading Translator",
    "slug": "reading-translator",
    "version": "0.1.0",
    "orientation": "default",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.readingtranslator.app" },
    "android": { "package": "com.readingtranslator.app" },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Reading Translator to photograph book pages for on-device text recognition.", "recordAudioAndroid": false }],
      "expo-sqlite"
    ]
  }
}
